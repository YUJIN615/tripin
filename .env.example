# 데이터베이스 (로컬 개발은 SQLite)
DATABASE_URL="file:./dev.db"

# ── Auth.js ──────────────────────────────────────
# 쿠키 서명/암호화 키. 아래 명령으로 생성하세요.
#   openssl rand -base64 33
AUTH_SECRET=""

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서
# "OAuth 2.0 클라이언트 ID"(웹 애플리케이션)를 만들고 값을 채우세요.
#
# 승인된 리디렉션 URI에 아래를 등록해야 합니다.
#   개발  http://localhost:3000/api/auth/callback/google
#   운영  https://<도메인>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 운영 배포 시 서비스의 정식 URL을 지정하세요.
# 지정하지 않으면 Auth.js가 요청의 Host 헤더를 믿어야 하므로
# 호스트 헤더 변조로 콜백이 탈취될 여지가 생깁니다.
# AUTH_URL="https://<도메인>"

# ── 선택 ─────────────────────────────────────────
# MSW 목업 비활성화
# NEXT_PUBLIC_USE_MSW=false
